<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://imballaggioComuneDetailView.title"
      focusComponent="form">
    <data>
        <instance id="imballaggioComuneDc"
                  class="it.ac.cargoflow.entity.ImballaggioComune">
            <fetchPlan extends="_base"/>
            <loader id="imballaggioComuneDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="imballaggioComuneDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="numField" property="num" allowedCharPattern="^[0-9]+$" label="msg://numField.label">
                <prefix>
                    <span text="MP"/>
                </prefix>
            </textField>
            <textArea id="descrizioneField" property="descrizione"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
