<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://incaricoListView.title"
      focusComponent="incaricoesDataGrid">
    <data>
        <collection id="incaricoesDc"
                    class="it.ac.cargoflow.entity.Incarico">
            <fetchPlan extends="_base">
                <property name="mittente" fetchPlan="_base">
                    <property name="azienda" fetchPlan="_base"/>
                </property>
                <property name="destinatario" fetchPlan="_base">
                    <property name="azienda" fetchPlan="_base"/>
                </property>
                <property name="azienda" fetchPlan="_base"/>
                <property name="contrassegno_tipo" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="incaricoesDl" readOnly="true">
                <query>
                    <![CDATA[select e from Incarico e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="incaricoesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="incaricoesDataGrid.createAction"/>
                <button id="editButton" action="incaricoesDataGrid.editAction"/>
                <button id="refreshButton" action="incaricoesDataGrid.refreshAction"/>
                <button id="removeButton" action="incaricoesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="incaricoesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="incaricoesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="incaricoesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="refreshAction" type="list_refresh"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="ldv"/>
                <column property="data_consegna_prevista"/>
                <column property="ritiro"/>
                <column property="mittente"/>
                <column property="destinatario"/>
                <column property="azienda"/>
                <column property="contrassegno"/>
                <column property="note"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
