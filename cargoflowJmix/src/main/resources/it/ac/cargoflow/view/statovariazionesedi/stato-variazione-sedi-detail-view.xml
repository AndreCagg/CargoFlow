<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://statoVariazioneSediDetailView.title"
      focusComponent="form">
    <data>
        <instance id="statoVariazioneSediDc"
                  class="it.ac.cargoflow.entity.StatoVariazioneSedi">
            <fetchPlan extends="_base"/>
            <loader id="statoVariazioneSediDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="statoVariazioneSediDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <select id="statoField" property="stato"/>
            <dateTimePicker id="dataStatoField" property="dataStato" label="msg://dataStatoField.label"/>
            <textArea id="noteField" height="9.5em" property="note"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
