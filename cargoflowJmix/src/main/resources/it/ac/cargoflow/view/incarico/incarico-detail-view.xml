<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://incaricoDetailView.title"
      focusComponent="form">
    <data>
        <collection id="clientiDc" class="it.ac.cargoflow.entity.Cliente">
            <loader id="clientiDl" readOnly="true">
                <query>
                    <![CDATA[select c from Cliente c
                        where (:currentMittenteId is null or c.id <> :currentMittenteId)
                        and (:currentDestinatarioId is null or c.id <> :currentDestinatarioId)
                        order by c.ragioneSociale asc]]>
                </query>
            </loader>
        </collection>
        <instance id="incaricoDc"
                  class="it.ac.cargoflow.entity.Incarico">
            <fetchPlan extends="_base">
                <property name="mittente" fetchPlan="_base">
                    <property name="azienda" fetchPlan="_base"/>
                </property>
                <property name="destinatario" fetchPlan="_base">
                    <property name="azienda" fetchPlan="_base"/>
                </property>
                <property name="azienda" fetchPlan="_base"/>
                <property name="contrassegno_tipo" fetchPlan="_base"/>
                <property name="sedi_mitt_dest" fetchPlan="_base">
                    <property name="incarico" fetchPlan="_base">
                        <property name="destinatario" fetchPlan="_base">
                            <property name="ragioneSociale"/>
                        </property>
                    </property>
                    <property name="sede_mittente" fetchPlan="_base">
                        <property name="ragioneSociale"/>
                        <property name="indirizzo"/>
                        <property name="cap"/>
                    </property>
                    <property name="sede_destinatario" fetchPlan="_base">
                        <property name="ragioneSociale"/>
                        <property name="indirizzo"/>
                        <property name="cap"/>
                    </property>
                </property>
                <property name="merce" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="incaricoDl"/>
            <collection id="sedi_mitt_destDc" property="sedi_mitt_dest"/>
            <collection id="merceDc" property="merce"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="incaricoDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="ldvField" property="ldv"/>
            <textField id="ddtField" property="ddt"/>
            <datePicker id="data_consegna_previstaField" property="data_consegna_prevista"/>
            <textField id="valore_doganaleField" property="valore_doganale"/>
            <checkbox id="ritiroField" property="ritiro"/>
            <textField id="valore_assicurazioneField" property="valore_assicurazione"/>
            <entityComboBox id="mittenteField" property="mittente" itemsContainer="clientiDc" allowCustomValue="true"/>
            <entityComboBox id="destinatarioField" property="destinatario" itemsContainer="clientiDc"
                            allowCustomValue="true"/>
            <entityPicker id="aziendaField" property="azienda">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <checkbox id="contrassegnoField" property="contrassegno"/>
            <textField id="contrassegno_valoreField" property="contrassegno_valore"/>
            <entityComboBox id="contrassegno_tipoField" property="contrassegno_tipo"/>
            <textArea id="noteField" height="9.5em" property="note"/>

            <hbox id="sedeMittDest">
                <entityPicker id="sedeMitt" label="Sede mittente" metaClass="Cliente">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityPicker>
                <entityPicker id="sedeDest" label="Sede destinatario" metaClass="Cliente">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityPicker>
            </hbox>
        </formLayout>
        <hbox id="merceButtonsPanel" classNames="buttons-panel">
            <button action="merceDataGrid.createAction"/>
            <button action="merceDataGrid.editAction"/>
            <button action="merceDataGrid.removeAction"/>
        </hbox>
        <dataGrid id="merceDataGrid" dataContainer="merceDc" width="100%" height="100%" allRowsVisible="true">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns>
                <column property="segnacollo"/>
                <column property="merce_tipo"/>
                <column property="peso_kg"/>
                <column property="volume_m3"/>
                <column property="fragile"/>
                <column property="epal"/>
                <column property="id_epal"/>
            </columns>
        </dataGrid>
        <hbox id="sedi_mitt_destButtonsPanel" classNames="buttons-panel">
            <button action="sedi_mitt_destDataGrid.createAction"/>
            <button action="sedi_mitt_destDataGrid.editAction"/>
            <button action="sedi_mitt_destDataGrid.removeAction"/>
        </hbox>
        <dataGrid id="sedi_mitt_destDataGrid" dataContainer="sedi_mitt_destDc" width="100%" height="100%"
                  allRowsVisible="true">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns>
                <column property="dal"/>
                <column property="al"/>
                <column property="autorizzazione"/>
                <column property="sede_mittente.ragioneSociale"/>
                <column property="sede_mittente.indirizzo"/>
                <column property="sede_mittente.cap"/>
                <column property="sede_destinatario.ragioneSociale"/>
                <column property="sede_destinatario.indirizzo"/>
                <column property="sede_destinatario.cap"/>
            </columns>
        </dataGrid>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
