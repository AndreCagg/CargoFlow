<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://clienteDetailView.title"
      focusComponent="form">
    <data>
        <instance id="clienteDc"
                  class="it.ac.cargoflow.entity.Cliente">
            <fetchPlan extends="_base">
                <property name="fasce_orarie" fetchPlan="_base">
                    <property name="fascia_oraria" fetchPlan="_base"/>
                </property>
            </fetchPlan>
            <loader id="clienteDl"/>
            <collection id="fasce_orarieDc" property="fasce_orarie"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="clienteDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="ragione_socialeField" property="ragione_sociale"/>
            <textField id="indirizzoField" property="indirizzo"/>
            <textField id="capField" property="cap"/>
            <textField id="telField" property="tel"/>
            <textField id="emailField" property="email"/>
            <checkbox id="vettoreField" property="vettore"/>
        </formLayout>
        <h4 text="msg://it.ac.cargoflow.entity/Cliente.fasce_orarie"/>
        <hbox id="fasce_orarieButtonsPanel" classNames="buttons-panel">
            <button action="fasce_orarieDataGrid.createAction"/>
            <button action="fasce_orarieDataGrid.editAction"/>
            <button action="fasce_orarieDataGrid.removeAction"/>
        </hbox>
        <dataGrid id="fasce_orarieDataGrid" dataContainer="fasce_orarieDc" width="100%" minHeight="20em">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns>
                <column property="ritiro"/>
                <column property="fascia_oraria"/>
            </columns>
        </dataGrid>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
