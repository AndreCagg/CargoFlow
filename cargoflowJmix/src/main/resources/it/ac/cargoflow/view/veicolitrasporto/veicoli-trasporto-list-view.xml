<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://veicoliTrasportoListView.title"
      focusComponent="veicoliTrasportoesDataGrid">
    <data>
        <collection id="veicoliTrasportoesDc"
                    class="it.ac.cargoflow.entity.VeicoliTrasporto">
            <fetchPlan extends="_base"/>
            <loader id="veicoliTrasportoesDl" readOnly="true">
                <query>
                    <![CDATA[select e from VeicoliTrasporto e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="veicoliTrasportoesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="veicoliTrasportoesDataGrid.createAction"/>
                <button id="editButton" action="veicoliTrasportoesDataGrid.editAction"/>
                <button id="removeButton" action="veicoliTrasportoesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="veicoliTrasportoesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="veicoliTrasportoesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="veicoliTrasportoesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="targa"/>
                <column property="adr"/>
                <column property="cisternaAdr"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
