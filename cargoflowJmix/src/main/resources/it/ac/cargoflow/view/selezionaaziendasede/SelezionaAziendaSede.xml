<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://selezionaaziendasede.title">
    <data>
        <collection id="aziendasDc" class="it.ac.cargoflow.entity.Azienda">
            <loader id="aziendasDl" readOnly="true">
                <query>
                    <![CDATA[select e from Azienda e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
        <collection id="sedesDc" class="it.ac.cargoflow.entity.Sede">
            <fetchPlan extends="_base"/>
            <loader id="sediDl" readOnly="true">
                <query>
                    <![CDATA[select e from Sede e where e.azienda.id = :idAzienda]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <entityComboBox id="azienda" itemsContainer="aziendasDc" metaClass="Azienda" visible="false">
            <actions>
                <action id="entityClear" type="entity_clear"/>
            </actions>
        </entityComboBox>

        <entityComboBox id="sede" itemsContainer="sedesDc" metaClass="Sede" visible="false">
            <actions>
                <action id="entityClear" type="entity_clear"/>
            </actions>
        </entityComboBox>

        <button id="salta" text="Salta"/>
        <button id="avanti" text="Avanti"/>
    </layout>
</view>