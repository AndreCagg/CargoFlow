<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://disposizioniSpecialiADRDetailView.title"
      focusComponent="form">
    <data>
        <instance id="disposizioniSpecialiADRDc"
                  class="it.ac.cargoflow.entity.DisposizioniSpecialiADR">
            <fetchPlan extends="_base"/>
            <loader id="disposizioniSpecialiADRDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="disposizioniSpecialiADRDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="numField" property="num" label="msg://descrizioneField.label"/>
            <textArea id="descrizioneField" height="9.5em" property="descrizione"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
