<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://incaricoFasciaOrariaDetailView.title"
      focusComponent="form">
    <data>
        <instance id="incaricoFasciaOrariaDc"
                  class="it.ac.cargoflow.entity.IncaricoFasciaOraria">
            <fetchPlan extends="_base">
                <property name="incarico" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="incaricoFasciaOrariaDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="incaricoFasciaOrariaDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <select id="giornoField" property="giorno"/>
            <timePicker id="dalleField" property="dalle"/>
            <timePicker id="alleField" property="alle"/>
            <entityPicker id="incaricoField" property="incarico">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <checkbox id="soloRitiroField" property="soloRitiro"/>
            <checkbox id="soloConsegnaField" property="soloConsegna"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
