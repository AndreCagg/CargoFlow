<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://LQListView.title"
      focusComponent="lQsDataGrid">
    <data>
        <collection id="lQsDc"
                    class="it.ac.cargoflow.entity.LQ">
            <fetchPlan extends="_base"/>
            <loader id="lQsDl" readOnly="true">
                <query>
                    <![CDATA[select e from LQ e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="lQsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="lQsDataGrid.createAction"/>
                <button id="editButton" action="lQsDataGrid.editAction"/>
                <button id="removeButton" action="lQsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="lQsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="lQsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="lQsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="valoreCombinatiCollo"/>
                <column property="combinatoInternoNonAutorizzato"/>
                <column property="combinatoColloNonAutorizzato"/>
                <column property="pellicolaInternoNonAutorizzato"/>
                <column property="pellicolaColloNonAutorizzato"/>
                <column property="combinatoInternoIllimitato"/>
                <column property="combinatoColloIllimitato"/>
                <column property="pellicolaInternoIllimitato"/>
                <column property="pellicolaColloIllimitato"/>
                <column property="combinatoInternoRiservato"/>
                <column property="combinatoColloRiservato"/>
                <column property="pellicolaInternoRiservato"/>
                <column property="pellicolaColloRiservato"/>
                <column property="valorePellicolaInterno"/>
                <column property="valorePellicolaCollo"/>
                <column property="valoreCombinatiInterno"/>
                <column property="um"/>
                <column property="lq"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
