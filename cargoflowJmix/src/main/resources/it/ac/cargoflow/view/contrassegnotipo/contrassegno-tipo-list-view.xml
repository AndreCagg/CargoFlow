<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://contrassegnoTipoListView.title"
      focusComponent="contrassegnoTipoesDataGrid">
    <data>
        <collection id="contrassegnoTipoesDc"
                    class="it.ac.cargoflow.entity.ContrassegnoTipo">
            <fetchPlan extends="_base"/>
            <loader id="contrassegnoTipoesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ContrassegnoTipo e]]>
                </query>
            </loader>
        </collection>
        <instance id="contrassegnoTipoDc"
                  class="it.ac.cargoflow.entity.ContrassegnoTipo">
            <fetchPlan extends="_base"/>
            <loader id="contrassegnoTipoDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout id="layoutWrapper" classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="contrassegnoTipoesDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <startSlot>
                        <button id="createButton" action="contrassegnoTipoesDataGrid.createAction"/>
                        <button id="editButton" action="contrassegnoTipoesDataGrid.editAction"/>
                        <button id="refreshButton" action="contrassegnoTipoesDataGrid.refreshAction"/>
                        <button id="removeButton" action="contrassegnoTipoesDataGrid.removeAction"/>
                    </startSlot>
                    <endSlot>
                        <simplePagination id="pagination" dataLoader="contrassegnoTipoesDl"/>
                    </endSlot>
                </hbox>
                <dataGrid id="contrassegnoTipoesDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="contrassegnoTipoesDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="createAction" type="list_create"/>
                        <action id="editAction" type="list_edit"/>
                        <action id="refreshAction" type="list_refresh"/>
                        <action id="removeAction" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="descrizione"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectButton" action="selectAction"/>
                    <button id="discardButton" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="contrassegnoTipoDc">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1"/>
                        <responsiveStep minWidth="40em" columns="2"/>
                    </responsiveSteps>
                    <textField id="descrizioneField" property="descrizione"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveButton" text="msg:///actions.Save" icon="OK" themeNames="primary"/>
                    <button id="cancelButton" text="msg:///actions.Cancel" icon="CANCEL"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>
