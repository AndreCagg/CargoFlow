<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://aziendaDetailView.title"
      focusComponent="form">
    <data>
        <instance id="aziendaDc"
                  class="it.ac.cargoflow.entity.Azienda">
            <fetchPlan extends="_base">
                <property name="sede" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="aziendaDl"/>
            <collection id="sedeDc" property="sede"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="aziendaDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="denominazioneField" property="denominazione"/>
        </formLayout>
        <h4 text="msg://it.ac.cargoflow.entity/Azienda.sede"/>
        <hbox id="sedeButtonsPanel" classNames="buttons-panel">
            <button action="sedeDataGrid.createAction"/>
            <button action="sedeDataGrid.editAction"/>
            <button action="sedeDataGrid.removeAction"/>
        </hbox>
        <dataGrid id="sedeDataGrid" dataContainer="sedeDc" width="100%" minHeight="20em">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns>
                <column property="nome"/>
            </columns>
        </dataGrid>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
