<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://classePericoloListView.title"
      focusComponent="classePericoloesDataGrid">
    <data>
        <collection id="classePericoloesDc"
                    class="it.ac.cargoflow.entity.ClassePericolo">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="classePericoloesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ClassePericolo e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="classePericoloesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="classePericoloesDataGrid.createAction"/>
                <button id="editButton" action="classePericoloesDataGrid.editAction"/>
                <button id="removeButton" action="classePericoloesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="classePericoloesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="classePericoloesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="classePericoloesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="classe"/>
                <column property="parent"/>
                <column property="descrizione"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
