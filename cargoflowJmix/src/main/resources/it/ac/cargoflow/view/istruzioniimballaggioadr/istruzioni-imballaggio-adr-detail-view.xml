<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://istruzioniImballaggioADRDetailView.title"
      focusComponent="form">
    <data>
        <instance id="istruzioniImballaggioADRDc"
                  class="it.ac.cargoflow.entity.IstruzioniImballaggioADR">
            <fetchPlan extends="_base">
                <property name="variante" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="istruzioniImballaggioADRDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="istruzioniImballaggioADRDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <hbox>
                <select id="tipoField" property="tipo" dataContainer="istruzioniImballaggioADRDc"
                        label="msg://tipoField.label" width="30%"/>
                <textField id="numField" property="num" dataContainer="istruzioniImballaggioADRDc"
                           label="msg://numField.label" width="100%"/>
            </hbox>

            <textArea id="descrizioneField" property="descrizione"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
