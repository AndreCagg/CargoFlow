<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://fasciaOrariaClienteListView.title"
      focusComponent="fasciaOrariaClientesDataGrid">
    <data>
        <collection id="fasciaOrariaClientesDc"
                    class="it.ac.cargoflow.entity.FasciaOrariaCliente">
            <fetchPlan extends="_base">
                <property name="fascia_oraria" fetchPlan="_base">
                    <property name="giorno" fetchPlan="_base"/>
                    <property name="fascia_oraria" fetchPlan="_base"/>
                </property>
                <property name="cliente" fetchPlan="_base">
                    <property name="azienda" fetchPlan="_base"/>
                </property>
            </fetchPlan>
            <loader id="fasciaOrariaClientesDl" readOnly="true">
                <query>
                    <![CDATA[select e from FasciaOrariaCliente e]]>
                </query>
            </loader>
        </collection>
        <instance id="fasciaOrariaClienteDc"
                  class="it.ac.cargoflow.entity.FasciaOrariaCliente">
            <fetchPlan extends="_base">
                <property name="fascia_oraria" fetchPlan="_base">
                    <property name="giorno" fetchPlan="_base"/>
                    <property name="fascia_oraria" fetchPlan="_base"/>
                </property>
                <property name="cliente" fetchPlan="_base">
                    <property name="azienda" fetchPlan="_base"/>
                </property>
            </fetchPlan>
            <loader id="fasciaOrariaClienteDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout padding="false">
        <formLayout id="layoutWrapper" classNames="master-detail-layout" height="100%">
            <vbox id="listLayout" height="100%">
                <genericFilter id="genericFilter"
                               dataLoader="fasciaOrariaClientesDl">
                    <properties include=".*"/>
                </genericFilter>
                <hbox id="buttonsPanel" classNames="buttons-panel">
                    <startSlot>
                        <button id="createButton" action="fasciaOrariaClientesDataGrid.createAction"/>
                        <button id="editButton" action="fasciaOrariaClientesDataGrid.editAction"/>
                        <button id="refreshButton" action="fasciaOrariaClientesDataGrid.refreshAction"/>
                        <button id="removeButton" action="fasciaOrariaClientesDataGrid.removeAction"/>
                    </startSlot>
                    <endSlot>
                        <simplePagination id="pagination" dataLoader="fasciaOrariaClientesDl"/>
                    </endSlot>
                </hbox>
                <dataGrid id="fasciaOrariaClientesDataGrid"
                          width="100%"
                          minHeight="20em"
                          dataContainer="fasciaOrariaClientesDc"
                          columnReorderingAllowed="true">
                    <actions>
                        <action id="createAction" type="list_create"/>
                        <action id="editAction" type="list_edit"/>
                        <action id="refreshAction" type="list_refresh"/>
                        <action id="removeAction" type="list_remove"/>
                    </actions>
                    <columns resizable="true">
                        <column property="fascia_oraria"/>
                        <column property="cliente"/>
                        <column property="ritiro"/>
                    </columns>
                </dataGrid>
                <hbox id="lookupActions" visible="false">
                    <button id="selectButton" action="selectAction"/>
                    <button id="discardButton" action="discardAction"/>
                </hbox>
            </vbox>
            <vbox id="detailsLayout" height="100%">
                <formLayout id="form" dataContainer="fasciaOrariaClienteDc">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1"/>
                        <responsiveStep minWidth="40em" columns="2"/>
                    </responsiveSteps>
                    <entityPicker id="fascia_orariaField" property="fascia_oraria">
                        <actions>
                            <action id="entityLookupAction" type="entity_lookup"/>
                            <action id="entityClearAction" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <entityPicker id="clienteField" property="cliente">
                        <actions>
                            <action id="entityLookupAction" type="entity_lookup"/>
                            <action id="entityClearAction" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <checkbox id="ritiroField" property="ritiro"/>
                </formLayout>
                <hbox id="detailActions">
                    <button id="saveButton" text="msg:///actions.Save" icon="OK" themeNames="primary"/>
                    <button id="cancelButton" text="msg:///actions.Cancel" icon="CANCEL"/>
                </hbox>
            </vbox>
        </formLayout>
    </layout>
</view>
