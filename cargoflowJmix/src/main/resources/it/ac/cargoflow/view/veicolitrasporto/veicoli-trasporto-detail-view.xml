<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://veicoliTrasportoDetailView.title"
      focusComponent="form">
    <data>
        <instance id="veicoliTrasportoDc"
                  class="it.ac.cargoflow.entity.VeicoliTrasporto">
            <fetchPlan extends="_base">
                <property name="certificati" fetchPlan="_base"/>
                <property name="codiceCisterna" fetchPlan="_base"/>
                <property name="disposizioniCisterna" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="veicoliTrasportoDl"/>
            <collection id="certificatiDc" property="certificati"/>
            <collection id="disposizioniCisternaDc" property="disposizioniCisterna"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="veicoliTrasportoDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="targaField" property="targa"/>
            <textField id="portataUtileField" property="portataUtile"/>
            <textField id="volumeUtileField" property="volumeUtile"/>
            <select id="mtaField" property="mta"
                    label="Massa complessiva a pieno carico"/>
            <checkbox id="adrField" property="adr" label="msg://adrField.label"/>
        </formLayout>

        <vbox id="adrVbox" padding="false" width="100%">
            <formLayout id="adrForm" dataContainer="veicoliTrasportoDc">
                <responsiveSteps>
                    <responsiveStep minWidth="0" columns="1"/>
                    <responsiveStep minWidth="40em" columns="2"/>
                </responsiveSteps>
                <select id="tipologiaField" property="tipologia"
                        label="msg://tipologiaField.label"/>
                <hbox>
                    <checkbox id="pannelliAdrField" property="pannelliAdr"
                              label="msg://pannelliAdrField.label" dataContainer="veicoliTrasportoDc"/>
                    <checkbox id="etichetteAdrField" property="etichetteAdr"
                              label="msg://etichetteAdrField.label" dataContainer="veicoliTrasportoDc"/>
                    <checkbox id="borsaEqAdrField" property="borsaEqAdr"
                              label="msg://borsaEqAdrField.label" dataContainer="veicoliTrasportoDc"/>
                </hbox>
                <numberField id="kgEstintoreField" property="kgEstintore"
                           label="Kg estintore"/>
                <entityComboBox id="codiceCisternaField" property="codiceCisterna"
                                label="msg://codiceCisternaField.label">
                    <actions>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityComboBox>
                <numberField id="pressioneCalcoloField" property="pressioneCalcolo"
                           label="msg://pressioneCalcoloField.label"/>
                <numberField id="pressioneProvaField" property="pressioneProva"
                           label="msg://pressioneProvaField.label"/>
            </formLayout>
        </vbox>

        <vbox id="certBox" padding="false">

            <h4 text="msg://h4.text"/>
            <hbox id="certificatiButtonsPanel" classNames="buttons-panel">
                <button action="certificatiDataGrid.addAction"/>
                <button action="certificatiDataGrid.excludeAction"/>
            </hbox>
            <dataGrid id="certificatiDataGrid" dataContainer="certificatiDc" width="100%" height="100%">
                <actions>
                    <action id="addAction" type="list_add">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="excludeAction" type="list_exclude"/>
                </actions>
                <columns>
                    <column property="codice"/>
                    <column property="descrizione"/>
                </columns>
            </dataGrid>
        </vbox>

        <vbox id="disposizCisternaBox" padding="false">

            <h4 text="Disposizioni ADR cisterna"/>
            <hbox id="disposizioniCisternaButtonsPanel" classNames="buttons-panel">
                <button action="disposizioniCisternaDataGrid.addAction"/>
                <button action="disposizioniCisternaDataGrid.excludeAction"/>
            </hbox>
            <dataGrid id="disposizioniCisternaDataGrid" dataContainer="disposizioniCisternaDc" width="100%" height="100%">
                <actions>
                    <action id="addAction" type="list_add">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="excludeAction" type="list_exclude"/>
                </actions>
                <columns>
                    <column property="tipoRequisito"/>
                    <column property="descrizione"/>
                    <column property="num"/>
                    <column property="tipo"/>
                </columns>
            </dataGrid>

            <hbox id="detailActions">
                <button id="saveAndCloseButton" action="saveCloseAction"/>
                <button id="closeButton" action="closeAction"/>
            </hbox>
        </vbox>
    </layout>
</view>