<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://elementoADRDetailView.title"
      focusComponent="form">
    <data>
        <collection id="imballaggioComunesDc" class="it.ac.cargoflow.entity.ImballaggioComune">
            <loader id="imballaggioComunesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ImballaggioComune e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
        <collection id="disposizioniCisternaADRsDc" class="it.ac.cargoflow.entity.DisposizioniCisternaADR">
            <loader id="disposizioniCisternaADRsDl" readOnly="true">
                <query>
                    <![CDATA[select e from DisposizioniCisternaADR e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
        <collection id="trasportoCollisDc" class="it.ac.cargoflow.entity.TrasportoColli">
            <loader id="trasportoCollisDl" readOnly="true">
                <query>
                    <![CDATA[select e from TrasportoColli e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
        <collection id="trasportoRinfusasDc" class="it.ac.cargoflow.entity.TrasportoRinfusa">
            <loader id="trasportoRinfusasDl" readOnly="true">
                <query>
                    <![CDATA[select e from TrasportoRinfusa e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
        <instance id="elementoADRDc"
                  class="it.ac.cargoflow.entity.ElementoADR">
            <fetchPlan extends="_base">
                <property name="classePericolo" fetchPlan="_base">
                    <property name="parent" fetchPlan="_base"/>
                </property>
                <property name="etichette" fetchPlan="_base"/>
                <property name="disposizioniSpeciali" fetchPlan="_base"/>
                <property name="istruzioniImballaggio" fetchPlan="_base">
                    <property name="variante" fetchPlan="_base"/>
                </property>
                <property name="disposizioniImballaggio" fetchPlan="_base"/>
                <property name="imballaggioComune" fetchPlan="_base"/>
                <property name="trasportoColli" fetchPlan="_base"/>
                <property name="rinfusa" fetchPlan="_base"/>
                <property name="caricoScaricoMovimentazione" fetchPlan="_base"/>
                <property name="disposizioniCisterna" fetchPlan="_base"/>
                <property name="esercizi" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="elementoADRDl"/>
            <collection id="etichetteDc" property="etichette"/>
            <collection id="disposizioniSpecialiDc" property="disposizioniSpeciali"/>
            <collection id="istruzioniImballaggioDc" property="istruzioniImballaggio"/>
            <collection id="disposizioniImballaggioDc" property="disposizioniImballaggio"/>
            <collection id="caricoScaricoMovimentazioneDc" property="caricoScaricoMovimentazione"/>
            <collection id="eserciziDc" property="esercizi"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="elementoADRDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="onuField" property="onu" label="ONU" allowedCharPattern="^[0-9]+$">
                <prefix>
                    <span text="UN"/>
                </prefix>
            </textField>
            <textField id="denominazioneField" property="denominazione" label="Denominazione Ufficiale"/>
            <hbox>
                <checkbox id="colli" label="msg://colli.label" property="colli" dataContainer="elementoADRDc"/>
                <checkbox id="rinfusa" label="msg://rinfusa.label" dataContainer="elementoADRDc" property="tRinfusa"/>
                <checkbox id="cisterna" label="msg://cisterna.label" dataContainer="elementoADRDc" property="cisterna"/>
            </hbox>
            <select id="gruppoImballaggioField" property="gruppoImballaggio" visible="false"
                    emptySelectionAllowed="true">
                <prefix>
                    <span text="PG"/>
                </prefix>
            </select>
            <!--<entityPicker id="classePericoloField" property="classePericolo">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>-->
            <textField id="quantitaLimitateField" property="quantitaLimitate" allowedCharPattern="^[0-9]+$"
                       visible="false">
                <prefix>
                    <span text="LQ"/>
                </prefix>
            </textField>
            <textField id="quantitaEsentiField" property="quantitaEsenti" allowedCharPattern="^[0-9]+$" visible="false">
                <prefix>
                    <span text="E"/>
                </prefix>
            </textField>
            <entityComboBox id="imballaggioComuneField" property="imballaggioComune" label="Imballaggio in comune"
                            itemsContainer="imballaggioComunesDc" visible="false">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityComboBox>
            <select id="codiceCisternaField" property="codiceCisterna" visible="false"/>
            <entityComboBox id="disposizioniCisternaField" property="disposizioniCisterna" label="Disposizioni Cisterna"
                            itemsContainer="disposizioniCisternaADRsDc" visible="false">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityComboBox>
            <textField id="categoriaTrasportoField" property="categoriaTrasporto" allowedCharPattern="^[0-4]$"
                       maxLength="1"/>
            <textField id="limiteGalleriaField" label="Restrizione Trasporto Galleria">
                <validators>
                    <regexp regexp="^[ABCDE][0-9]+[ABCDE]$"
                            message="Formato restrizione galleria non valido (es. C5000D)"/>
                </validators>
            </textField>
            <!--<textField id="limiteGalleriaField" property="limiteGalleria"/>
            <textField id="codRestrizioneAField" property="codRestrizioneA"/>
            <textField id="codRestrizioneBField" property="codRestrizioneB"/>-->
            <entityComboBox id="trasportoColliField" property="trasportoColli" itemsContainer="trasportoCollisDc"
                            visible="false">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityComboBox>
            <entityComboBox id="rinfusaField" property="rinfusa" itemsContainer="trasportoRinfusasDc" visible="false">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityComboBox>
            <textField id="codicePericoloField" property="codicePericolo">
                <validators>
                    <regexp regexp="^X?[0-9]{2,3}$"/>
                </validators>
            </textField>
            <select id="umField" property="um"/>
        </formLayout>
        <vbox id="etichette" visible="false" padding="false">
            <h4 text="msg://it.ac.cargoflow.entity/ElementoADR.etichette"/>
            <hbox id="etichetteButtonsPanel" classNames="buttons-panel">
                <button action="etichetteDataGrid.addAction"/>
                <button action="etichetteDataGrid.excludeAction"/>
            </hbox>
            <dataGrid id="etichetteDataGrid" dataContainer="etichetteDc" width="100%" minHeight="20em">
                <actions>
                    <action id="addAction" type="list_add"/>
                    <action id="excludeAction" type="list_exclude"/>
                </actions>
                <columns>
                    <column property="num" header="msg://column2.header"/>
                    <column property="descrizione"/>
                </columns>
            </dataGrid>
        </vbox>
        <h4 text="msg://it.ac.cargoflow.entity/ElementoADR.disposizioniSpeciali"/>
        <hbox id="disposizioniSpecialiButtonsPanel" classNames="buttons-panel">
            <button action="disposizioniSpecialiDataGrid.addAction"/>
            <button action="disposizioniSpecialiDataGrid.excludeAction"/>
        </hbox>
        <dataGrid id="disposizioniSpecialiDataGrid" dataContainer="disposizioniSpecialiDc" width="100%"
                  minHeight="20em">
            <actions>
                <action id="addAction" type="list_add"/>
                <action id="excludeAction" type="list_exclude"/>
            </actions>
            <columns>
                <column property="num" header="msg://column.header"/>
                <column property="descrizione"/>
            </columns>
        </dataGrid>
        <vbox id="imballaggio" visible="false" padding="false">
            <h4 text="msg://it.ac.cargoflow.entity/ElementoADR.istruzioniImballaggio"/>
            <hbox id="istruzioniImballaggioButtonsPanel" classNames="buttons-panel">
                <button action="istruzioniImballaggioDataGrid.addAction"/>
                <button action="istruzioniImballaggioDataGrid.excludeAction"/>
            </hbox>
            <dataGrid id="istruzioniImballaggioDataGrid" dataContainer="istruzioniImballaggioDc" width="100%"
                      minHeight="20em">
                <actions>
                    <action id="addAction" type="list_add"/>
                    <action id="excludeAction" type="list_exclude"/>
                </actions>
                <columns>
                    <column key="codice" header="msg://column1.header"/>
                    <column property="descrizione"/>
                </columns>
            </dataGrid>
        </vbox>
        <vbox id="disposizioniImballaggio" visible="false" padding="false">
            <h4 text="msg://it.ac.cargoflow.entity/ElementoADR.disposizioniImballaggio"/>
            <hbox id="disposizioniImballaggioButtonsPanel" classNames="buttons-panel">
                <button action="disposizioniImballaggioDataGrid.addAction"/>
                <button action="disposizioniImballaggioDataGrid.excludeAction"/>
            </hbox>
            <dataGrid id="disposizioniImballaggioDataGrid" dataContainer="disposizioniImballaggioDc" width="100%"
                      minHeight="20em">
                <actions>
                    <action id="addAction" type="list_add"/>
                    <action id="excludeAction" type="list_exclude"/>
                </actions>
                <columns>
                    <column key="codice" header="msg://column3.header"/>
                    <column property="descrizione"/>
                </columns>
            </dataGrid>
        </vbox>
        <h4 text="msg://it.ac.cargoflow.entity/ElementoADR.caricoScaricoMovimentazione"/>
        <hbox id="caricoScaricoMovimentazioneButtonsPanel" classNames="buttons-panel">
            <button action="caricoScaricoMovimentazioneDataGrid.addAction"/>
            <button action="caricoScaricoMovimentazioneDataGrid.excludeAction"/>
        </hbox>
        <dataGrid id="caricoScaricoMovimentazioneDataGrid" dataContainer="caricoScaricoMovimentazioneDc" width="100%"
                  minHeight="20em">
            <actions>
                <action id="addAction" type="list_add"/>
                <action id="excludeAction" type="list_exclude"/>
            </actions>
            <columns>
                <column property="sigla" key="sigla"/>
                <column property="emergenza"/>
                <column property="azione"/>
            </columns>
        </dataGrid>
        <h4 text="msg://h4.text"/>
        <hbox id="eserciziButtonsPanel" classNames="buttons-panel">
            <button action="eserciziDataGrid.addAction"/>
            <button action="eserciziDataGrid.excludeAction"/>
        </hbox>
        <dataGrid id="eserciziDataGrid" dataContainer="eserciziDc" width="100%" height="100%">
            <actions>
                <action id="addAction" type="list_add">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="excludeAction" type="list_exclude"/>
            </actions>
            <columns>
                <column property="codice" key="codice"/>
                <column property="descrizione"/>
            </columns>
        </dataGrid>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
