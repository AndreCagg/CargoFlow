<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="cargoflowJmix">
        <addColumn tableName="USER_">
            <column name="AZIENDA_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="2" author="cargoflowJmix">
        <addColumn tableName="USER_">
            <column name="RUOLO" type="VARCHAR(255)"/>
        </addColumn>

    </changeSet>
    <changeSet id="3" author="cargoflowJmix">
        <createIndex indexName="IDX_USER__AZIENDA" tableName="USER_">
            <column name="AZIENDA_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="AZIENDA_ID" baseTableName="USER_" constraintName="FK_USER__ON_AZIENDA"
                                 referencedColumnNames="ID" referencedTableName="AZIENDA"/>
    </changeSet>
    <changeSet id="4" author="cargoflowJmix">
        <dropColumn columnName="DESCRIZIONE" tableName="MOVIMENTI"/>
    </changeSet>
    <changeSet id="5" author="cargoflowJmix">
        <addColumn tableName="MOVIMENTI">
            <column name="DESCRIZIONE" type="INT"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>