<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="it/ac/cargoflow/liquibase/changelog/2026/09/18-085102-ed8687c7.xml">
    <changeSet id="1" author="cargoflowJmix">
        <createTable tableName="VEICOLI">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_VEICOLI"/>
            </column>
            <column name="DTYPE" type="VARCHAR(31)"/>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="TARGA" type="VARCHAR(255)"/>
            <column name="ADR" type="BOOLEAN"/>
            <column name="CISTERNA_ADR" type="BOOLEAN"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="cargoflowJmix">
        <createTable tableName="VEICOLI_TRASPORTO_REQUISITO_VEICOLO_LINK">
            <column name="REQUISITO_VEICOLO_ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true"
                             primaryKeyName="PK_VEICOLI_TRASPORTO_REQUISITO_VEICOLO_LINK"/>
            </column>
            <column name="VEICOLI_TRASPORTO_ID" type="UUID">
                <constraints nullable="false" primaryKey="true"
                             primaryKeyName="PK_VEICOLI_TRASPORTO_REQUISITO_VEICOLO_LINK"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="3" author="cargoflowJmix">
        <addForeignKeyConstraint baseColumnNames="REQUISITO_VEICOLO_ID"
                                 baseTableName="VEICOLI_TRASPORTO_REQUISITO_VEICOLO_LINK"
                                 constraintName="FK_VEITRAREQVEI_ON_REQUISITO_VEICOLO" referencedColumnNames="ID"
                                 referencedTableName="REQUISITO_VEICOLO"/>
    </changeSet>
    <changeSet id="4" author="cargoflowJmix">
        <addForeignKeyConstraint baseColumnNames="VEICOLI_TRASPORTO_ID"
                                 baseTableName="VEICOLI_TRASPORTO_REQUISITO_VEICOLO_LINK"
                                 constraintName="FK_VEITRAREQVEI_ON_VEICOLI_TRASPORTO" referencedColumnNames="ID"
                                 referencedTableName="VEICOLI"/>
    </changeSet>
    <changeSet id="5" author="cargoflowJmix">
        <dropColumn columnName="created_by" tableName="t_rasporto_rinfusa"/>

        <dropColumn columnName="created_date" tableName="t_rasporto_rinfusa"/>

        <dropColumn columnName="deleted_by" tableName="t_rasporto_rinfusa"/>

        <dropColumn columnName="deleted_date" tableName="t_rasporto_rinfusa"/>

        <dropColumn columnName="last_modified_by" tableName="t_rasporto_rinfusa"/>

        <dropColumn columnName="last_modified_date" tableName="t_rasporto_rinfusa"/>

        <dropColumn columnName="version" tableName="t_rasporto_rinfusa"/>
    </changeSet>
    <changeSet id="6" author="cargoflowJmix">
        <dropColumn columnName="RINFUSA_ID" tableName="ELEMENTO_ADR"/>
    </changeSet>
    <changeSet id="7" author="cargoflowJmix">
        <addColumn tableName="ELEMENTO_ADR">
            <column name="RINFUSA_ID" type="BIGINT">
                <constraints deleteCascade="false" foreignKeyName="FK_ELEMENTO_ADR_ON_RINFUSA"
                             references="T_RASPORTO_RINFUSA(ID)"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>