<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="it/ac/cargoflow/liquibase/changelog/2026/09/18-143614-ed8687c7.xml">
    <changeSet id="1" author="cargoflowJmix">
        <addColumn tableName="VEICOLI">
            <column name="AZIENDA_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="2" author="cargoflowJmix">
        <addColumn tableName="REQUISITO_VEICOLO">
            <column name="DESCRIZIONE" type="CLOB"/>
        </addColumn>

        <addNotNullConstraint columnName="DESCRIZIONE" defaultNullValue="''" tableName="REQUISITO_VEICOLO"/>
    </changeSet>
    <changeSet id="3" author="cargoflowJmix">
        <addColumn tableName="REQUISITO_VEICOLO">
            <column name="DTYPE" type="VARCHAR(31)"/>
        </addColumn>

        <update tableName="REQUISITO_VEICOLO">
            <column name="DTYPE" value="RequisitoVeicolo"/>
            <where>DTYPE is null</where>
        </update>
    </changeSet>
    <changeSet id="4" author="cargoflowJmix">
        <addColumn tableName="REQUISITO_VEICOLO">
            <column name="NUM" type="INT"/>
        </addColumn>

        <addNotNullConstraint columnName="NUM" defaultNullValue="0" tableName="REQUISITO_VEICOLO"/>
    </changeSet>
    <changeSet id="5" author="cargoflowJmix">
        <createIndex indexName="IDX_VEICOLI_AZIENDA" tableName="VEICOLI">
            <column name="AZIENDA_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="AZIENDA_ID" baseTableName="VEICOLI"
                                 constraintName="FK_VEICOLI_ON_AZIENDA" referencedColumnNames="ID"
                                 referencedTableName="SEDE"/>
    </changeSet>
    <changeSet id="6" author="cargoflowJmix">
        <dropColumn columnName="tipo" tableName="requisito_veicolo"/>
    </changeSet>
    <changeSet id="7" author="cargoflowJmix">
        <dropColumn columnName="version" tableName="trasporto_colli"/>
    </changeSet>
    <!-- 8. Rimuovi prima la vecchia FK esterna e la PK della tabella CODICE_CISTERNA -->
    <changeSet id="8" author="cargoflowJmix">
        <dropForeignKeyConstraint baseTableName="elemento_adr" constraintName="fk_elemento_adr_on_disposizioni_cisterna"/>
        <dropPrimaryKey tableName="CODICE_CISTERNA"/>
        <dropColumn columnName="ID" tableName="CODICE_CISTERNA"/>
    </changeSet>

    <!-- 9. Aggiungi la nuova PK / FK collegata a REQUISITO_VEICOLO -->
    <changeSet id="9" author="cargoflowJmix">
        <addColumn tableName="CODICE_CISTERNA">
            <column name="ID" type="BIGINT">
                <constraints deleteCascade="false" foreignKeyName="FK_CODICE_CISTERNA_ON_ID" nullable="false"
                             primaryKey="true" primaryKeyName="PK_CODICE_CISTERNA" references="REQUISITO_VEICOLO(ID)"
                             validateNullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 10. Ripristina la Foreign Key originale su elemento_adr -->
    <changeSet id="10-fk-restore" author="cargoflowJmix">
        <addForeignKeyConstraint baseColumnNames="DISPOSIZIONI_CISTERNA_ID" baseTableName="elemento_adr"
                                 constraintName="fk_elemento_adr_on_disposizioni_cisterna"
                                 referencedColumnNames="ID" referencedTableName="CODICE_CISTERNA"/>
    </changeSet>

    <!-- 11. Rigenera TRASPORTO_COLLI usando SQL CASCADE -->
    <changeSet id="11" author="cargoflowJmix">
        <sql>ALTER TABLE public.TRASPORTO_COLLI DROP CONSTRAINT PK_TRASPORTO_COLLI CASCADE;</sql>
        <dropColumn columnName="ID" tableName="TRASPORTO_COLLI"/>
        <addColumn tableName="TRASPORTO_COLLI">
            <column name="ID" type="BIGINT">
                <constraints deleteCascade="false" foreignKeyName="FK_TRASPORTO_COLLI_ON_ID" nullable="false"
                             primaryKey="true" primaryKeyName="PK_TRASPORTO_COLLI" references="REQUISITO_VEICOLO(ID)"
                             validateNullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 12. Rigenera T_RASPORTO_RINFUSA usando SQL CASCADE -->
    <changeSet id="12" author="cargoflowJmix">
        <sql>ALTER TABLE public.T_RASPORTO_RINFUSA DROP CONSTRAINT PK_T_RASPORTO_RINFUSA CASCADE;</sql>
        <dropColumn columnName="ID" tableName="T_RASPORTO_RINFUSA"/>
        <addColumn tableName="T_RASPORTO_RINFUSA">
            <column name="ID" type="BIGINT">
                <constraints deleteCascade="false" foreignKeyName="FK_T_RASPORTO_RINFUSA_ON_ID" nullable="false"
                             primaryKey="true" primaryKeyName="PK_T_RASPORTO_RINFUSA" references="REQUISITO_VEICOLO(ID)"
                             validateNullable="true"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>