<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="cargoflowJmix">
        <createTable tableName="INCARICO_FASCIA_ORARIA">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_INCARICO_FASCIA_ORARIA"/>
            </column>
            <column name="GIORNO" type="INT"/>
            <column name="DALLE" type="TIME"/>
            <column name="ALLE" type="TIME"/>
            <column name="INCARICO_ID" type="UUID"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="cargoflowJmix">
        <addColumn tableName="FASCIA_ORARIA">
            <column name="SOLO_CONSEGNA" type="BOOLEAN"/>
            <column name="SOLO_RITIRO" type="BOOLEAN"/>
        </addColumn>
    </changeSet>
    <changeSet id="3" author="cargoflowJmix">
        <createIndex indexName="IDX_INCARICO_FASCIA_ORARIA_INCARICO" tableName="INCARICO_FASCIA_ORARIA">
            <column name="INCARICO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="INCARICO_ID" baseTableName="INCARICO_FASCIA_ORARIA"
                                 constraintName="FK_INCARICO_FASCIA_ORARIA_ON_INCARICO" referencedColumnNames="ID"
                                 referencedTableName="INCARICO"/>
    </changeSet>
    <changeSet id="4" author="cargoflowJmix">
        <dropColumn columnName="ritiro" tableName="fascia_oraria"/>
    </changeSet>
</databaseChangeLog>